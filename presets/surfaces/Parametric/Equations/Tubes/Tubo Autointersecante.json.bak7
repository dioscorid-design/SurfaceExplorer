    "name": "Tubo Autointersecante",
    "projectionMode": 1,
    "renderMode": 1,
    "scriptCode": "// --- CONFIGURAZIONE ---\nu_min := 0;\nu_max := 6.28318; // 2*PI\nv_min := 0;\nv_max := 6.28318;\nsteps := 350;\n\n// --- CODICE SHADER ---\n// NB: non dichiarare variabili chiamate PI, pi, tau: il traduttore\n// le sostituisce col valore numerico in tutto lo script.\n\n// Parametri Geometrici\nfloat a = 3.0; // Ampiezza della lemniscata\nfloat r = 0.5; // Raggio del tubo\n\n// Curva: lemniscata di Gerono nel piano z=0.\n// Passa DUE volte per l'origine (u = 0 ed u = 3.14159): li' il tubo\n// si autointerseca.\nvec3 Curve = vec3(\n    a * sin(u),\n    a * sin(u) * cos(u),\n    0.0\n);\n\n// --- DERIVATA PRIMA (Velocita' Analitica) ---\nvec3 dC = vec3(\n    a * cos(u),\n    a * cos(2.0 * u),\n    0.0\n);\n\nvec3 Tangent = normalize(dC);\n\n// --- CALCOLO FRAME STABILE ---\n// La curva sta nel piano z=0: la tangente non risulta mai\n// parallela a Z, quindi il frame non degenera mai.\nvec3 Up = vec3(0.0, 0.0, 1.0);\nvec3 Binorm = normalize(cross(Tangent, Up));\nvec3 Norm = normalize(cross(Binorm, Tangent));\n\n// --- COSTRUZIONE TUBO ---\nvec3 pos = Curve + r * (cos(v) * Norm + sin(v) * Binorm);\n\n// Ritorno del punto in 4D (X, Y, Z, P)\nreturn vec4(pos * 0.35, 0.0);\n\n//CUTOUT_BEGIN\n// Taglio delle pareti interne nel punto di autointersezione.\n//\n// ERRORE della versione precedente: assumevo che l'incrocio in u=0 si\n// risolvesse confrontando col punto \"specchiato\" u_mirror = -u sullo STESSO\n// nodo. E' FALSO: i due bracci che si toccano in u=0 sono quello che ESCE\n// da u=0 (verso il primo quadrante) e quello che ARRIVA a u=3.14159 (dal\n// quarto quadrante) -- sono vicini nello SPAZIO 3D ma lontanissimi nel\n// parametro u. Il punto specchiato -u era quasi sempre troppo lontano nello\n// spazio 3D per essere utile: il test non scattava quasi mai, lasciando\n// lembi di parete interna intatti (visibili come cresta residua).\n//\n// FIX: quando u e' vicino a un nodo (0 o 3.14159), cerchiamo il vero minimo\n// di distanza campionando ATTORNO A ENTRAMBI i nodi (non solo quello piu'\n// vicino a u), escludendo solo il proprio intorno immediato. Verificato\n// numericamente: il test e' simmetrico (se un punto del ramo A risulta\n// dentro il ramo B, il punto REALMENTE sovrapposto sul ramo B viene\n// anch'esso tagliato) e resta confinato alla zona vera dell'incrocio (zero\n// tagli lontano dai nodi).\nfloat a2 = 3.0;\nfloat r2 = 0.5;\nfloat PI_2 = 3.14159265359;\n\n// Attivazione: il test si avvia solo se u e' vicino a un nodo (altrimenti\n// costo sprecato lontano dall'incrocio).\nfloat activateWindow = 0.5;\nfloat dNode0 = min(abs(u), PI_2 * 2.0 - abs(u));\nfloat dNodePi = abs(u - PI_2);\nbool nearNode = (dNode0 < activateWindow) || (dNodePi < activateWindow);\n\nbool didCut = false;\n\nif (nearNode) {\n    vec3 Curve2 = vec3(\n        a2 * sin(u),\n        a2 * sin(u) * cos(u),\n        0.0\n    );\n    vec3 dC2 = vec3(\n        a2 * cos(u),\n        a2 * cos(2.0 * u),\n        0.0\n    );\n    vec3 Tangent2 = normalize(dC2);\n    vec3 Up2 = vec3(0.0, 0.0, 1.0);\n    vec3 Binorm2 = normalize(cross(Tangent2, Up2));\n    vec3 Norm2 = normalize(cross(Binorm2, Tangent2));\n    vec3 pos2 = Curve2 + r2 * (cos(v) * Norm2 + sin(v) * Binorm2);\n\n    // Ricerca del vero minimo attorno a ENTRAMBI i nodi (0 e PI), sempre,\n    // qualunque nodo abbia attivato il test: e' l'unico modo corretto,\n    // perche' un tratto vicino al nodo 0 puo' toccare fisicamente un tratto\n    // vicino al nodo PI (vedi commento sopra).\n    float searchWindow = 0.5;\n    float sampleCount = 24.0;\n    float excludeSelf = 0.15;\n    float bestDist = 1000.0;\n\n    for (float nodeIdx = 0.0; nodeIdx < 2.0; nodeIdx = nodeIdx + 1.0) {\n        float node = (nodeIdx < 0.5) ? 0.0 : PI_2;\n        float lo = node - searchWindow;\n        float hi = node + searchWindow;\n        for (float k = 0.0; k < sampleCount; k = k + 1.0) {\n            float u2 = lo + (hi - lo) * (k / (sampleCount - 1.0));\n            float duSelf = abs(u2 - u);\n            duSelf = min(duSelf, PI_2 * 2.0 - duSelf);\n            if (duSelf < excludeSelf) { continue; }\n            vec3 c2 = vec3(a2 * sin(u2), a2 * sin(u2) * cos(u2), 0.0);\n            float d = length(pos2 - c2);\n            bestDist = min(bestDist, d);\n        }\n    }\n\n    didCut = (bestDist < r2);\n}\n\nreturn didCut;\n//CUTOUT_END",
    "showBorder": false,
    "steps": 350,
    "type": "surface",
    "use4DLighting": false
}
