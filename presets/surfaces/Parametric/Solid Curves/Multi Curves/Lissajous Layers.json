    "name": "Lissajous Layers",
    "projectionMode": 1,
    "renderMode": 1,
    "scriptCode": "// --- LISSAJOUS LAYERS ---\n// Five Lissajous figures, one above the other: the same frequencies A and B,\n// with the phase advancing by a tenth of a turn from layer to layer, so the\n// stack shows how the figure changes with the phase.\nA := int(1,9);\nB := int(1,9);\n//MESH_BEGIN\nu: 0, TAU, 200\nv: 0, TAU, 32\n//MESH_END\n//MESH_BEGIN\nu: 0, TAU, 200\nv: 0, TAU, 32\n//MESH_END\n//MESH_BEGIN\nu: 0, TAU, 200\nv: 0, TAU, 32\n//MESH_END\n//MESH_BEGIN\nu: 0, TAU, 200\nv: 0, TAU, 32\n//MESH_END\n//MESH_BEGIN\nu: 0, TAU, 200\nv: 0, TAU, 32\n//MESH_END\nfloat phase = mesh * 0.62831853;\nreturn vec4(sin(A*u + phase), sin(B*u), (mesh - 2.0) * 0.45, 0.0);\n",
