        "code": "// --- PARAMETRI ---\nfloat zoom = 10.0;  // <--- AUMENTATO DA 1.0 A 20.0 PER RIDURRE I BLOCCHI\nfloat s = 512.0;    // Risoluzione virtuale\n\n// --- LOGICA XOR ---\n// Convertiamo u, v (0.0-1.0) in coordinate intere scalate\n// Formula C++ originale: int xx = x * z / 5;\n// Qui moltiplichiamo per zoom alto per avere il pattern fitto\nint xx = int(u * s * zoom / 5.0);\nint yy = int(v * s * zoom / 5.0);\n\n// Formula XOR bitwise\nint val = (xx ^ yy) % 256;\n\n// Mappiamo a 0.0-1.0\nfloat tit = float(val) / 255.0;\n\n// --- GENERAZIONE COLORE PSICHEDELICO (Inline) ---\n// tit * 3.0 serve a fare 3 giri completi di spettro\nfloat time = tit * 3.0; \nfloat freq = 6.283; // 2 * PI\n\n// Calcolo componenti RGB con le fasi originali (0.00, 0.33, 0.67)\nfloat r_psy = 0.5 + 0.5 * cos(freq * time + 0.00);\nfloat g_psy = 0.5 + 0.5 * cos(freq * time + 0.33); \nfloat b_psy = 0.5 + 0.5 * cos(freq * time + 0.67); \n\nvec3 psyColor = vec3(r_psy, g_psy, b_psy);\n\n// --- MIX FINALE ---\n// Mischiamo il risultato psichedelico con la tinta base (Colore 1)\nreturn (psyColor + u_col1) * 0.5;",
